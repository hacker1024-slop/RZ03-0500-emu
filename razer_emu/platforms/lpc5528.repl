cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic
nvic: IRQControllers.NVIC @ sysbus 0xe000e000
    -> cpu@0
    systickFrequency: 96000000
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x30000
sramx: Memory.MappedMemory @ sysbus 0x04000000
    size: 0x8000
usbram: Memory.MappedMemory @ sysbus 0x40100000
    size: 0x4000
flash: MTD.RazerLpcFlash @ sysbus 0x00000000
syscon: Miscellaneous.RazerLpcSyscon @ {
        sysbus 0x40000000;
        sysbus 0x50000000
    }
pmc: Miscellaneous.RazerLpcPmc @ {
        sysbus 0x40020000;
        sysbus 0x50020000
    }
anactrl: Miscellaneous.RazerLpcAnalog @ {
        sysbus 0x40013000;
        sysbus 0x50013000
    }
// NMPA factory trim fields. Zero marks unavailable trim, selecting SDK defaults.
// This is a virtual untrimmed device, not a copy of the specimen's factory data.
nmpa: Memory.MappedMemory @ sysbus 0x0009fc00
    size: 0x400
flashController: MTD.RazerLpcFlashController @ {
        sysbus 0x40034000;
        sysbus 0x50034000
    }
    memory: flash
iocon: Miscellaneous.RazerLpcIocon @ {
        sysbus 0x40001000;
        sysbus 0x50001000
    }
    gpio: gpio
gpio: GPIOPort.RazerLpcGpio @ {
        sysbus 0x4008c000;
        sysbus 0x5008c000
    }
ctimer2: Timers.RazerLpcTimer @ {
        sysbus 0x40028000;
        sysbus 0x50028000
    }
    frequency: 96000000
    IRQ -> nvic@36
dma0: DMA.RazerLpcDma @ {
        sysbus 0x40082000;
        sysbus 0x50082000
    }
    IRQ -> nvic@1
flexcomm4: I2C.RazerLpcI2c @ {
        sysbus 0x4008a000;
        sysbus 0x5008a000
    }
    IRQ -> nvic@18
    DmaRead -> dma0@12
    DmaWrite -> dma0@13
flexcomm2: I2C.RazerLpcI2c @ {
        sysbus 0x40088000;
        sysbus 0x50088000
    }
    IRQ -> nvic@16
    DmaRead -> dma0@10
    DmaWrite -> dma0@11
wwdt: Timers.RazerLpcWatchdog @ {
        sysbus 0x4000c000;
        sysbus 0x5000c000
    }
ezh: Miscellaneous.RazerLpcEzh @ {
        sysbus 0x4001d000;
        sysbus 0x5001d000
    }
ctimer3: Timers.RazerLpcTimer @ {
        sysbus 0x40029000;
        sysbus 0x50029000
    }
    frequency: 96000000
    IRQ -> nvic@13
usbPort: Miscellaneous.RazerLpcUsbPort @ {
        sysbus 0x400a3000;
        sysbus 0x500a3000
    }
usbPhy: Miscellaneous.RazerLpcUsbPhy @ {
        sysbus 0x40038000;
        sysbus 0x50038000
    }
usbDevice: USB.RazerLpcUsbDevice @ {
        sysbus 0x40094000;
        sysbus 0x50094000
    }
    phy: usbPhy
    IRQ -> nvic@47
